---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyDetails from '../../components/CaseStudyDetails.astro';
import Sheet from '../../components/Sheet.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);
const caseStudies = sorted.filter((project) => project.data.kind === 'project');
const experienceEntries = sorted.filter((entry) => entry.data.kind === 'experience');
const sheetCount = experienceEntries.length > 0 ? 2 : 1;

const siteUrl = Astro.site?.toString() ?? 'https://shanekanterman.dev';
const pageUrl = new URL('/projects/', siteUrl).toString();

const description =
  'Infrastructure and platform case studies by Shane Kanterman, covering Linux systems, ephemeral CI, deployment tooling, and data center operations.';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Projects',
    description,
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sorted.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: project.data.title,
      url: new URL(`/projects/${project.id}/`, siteUrl).toString(),
    })),
  },
];
---

<BaseLayout
  title="Projects | Shane Kanterman"
  description={description}
  structuredData={structuredData}
  chatEnabled={true}
>
  <div class="page-shell relative z-10 pb-10">
    <SiteHeader backHref="/" backLabel="Home" />

    <main class="pt-6 max-[780px]:pt-3" id="main-content">
      <Sheet
        id="projects"
        sheet={1}
        of={sheetCount}
        label="Drawing index · case studies"
        drawing="DWG SK-02"
        animate={false}
        labelledBy="projects-title"
      >
        <h1 class="sheet-title" id="projects-title">Every case study, in one place.</h1>
        <p class="sheet-intro">
          Each write-up covers the boundaries, failure modes, and release decisions behind the
          system, not just the finished interface.
        </p>
        <CaseStudyDetails projects={caseStudies} />
      </Sheet>

      {experienceEntries.length > 0 && (
        <Sheet
          id="experience"
          sheet={2}
          of={sheetCount}
          label="Experience notes"
          drawing="DWG SK-04"
          labelledBy="experience-title"
        >
          <h2 class="sheet-title" id="experience-title">Production work outside the repositories.</h2>
          <p class="sheet-intro">
            Hands-on data center operations that shape how I evaluate everything above.
          </p>
          <div class="detail-grid">
            {experienceEntries.map((entry) => (
              <article class="detail-card dwg-box">
                <p class="dwg-label">Unit P · experience</p>
                <h3 class="detail-title">
                  <a href={`/projects/${entry.id}`}>{entry.data.title}</a>
                </h3>
                <p class="detail-summary">{entry.data.summary}</p>
                <a href={`/projects/${entry.id}`} class="text-link detail-more">
                  Read experience notes
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </Sheet>
      )}
    </main>
  </div>
</BaseLayout>
