---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import keyArt from '../assets/datacentertycoon/key-art.jpg';
import panelsShot from '../assets/datacentertycoon/panels.png';
import fieldNoteShot from '../assets/datacentertycoon/field-note.png';

const playtestUrl = 'mailto:shanekanterman04@gmail.com?subject=Data%20Center%20Tycoon%20playtest';

const loop = ['Plan the floor', 'Run power, cooling & network', 'Build servers', 'Sell hosting', 'Keep it up', 'Expand'];

const pillars = [
  {
    number: '01 / INFRASTRUCTURE',
    title: 'Every rack has to breathe.',
    body: 'Power, cooling, and network are real graphs. Racks pull cold air in the front and dump heat out the back, and a bad layout shows up as a thermal alarm.',
  },
  {
    number: '02 / BUSINESS',
    title: 'Uptime is the product.',
    body: 'Publish VPS offers or rent whole servers, sign contracts, answer tickets, and protect your reputation. Customers prepay, and you earn it by delivering service every day.',
  },
  {
    number: '03 / GROWTH',
    title: 'Garage to hyperscale.',
    body: 'Start with a few racks and a single tech. Hire staff, keep up with maintenance, outbid competitors, and grow into new facilities.',
  },
];

const systems = [
  'Thermal modeling with rack front/back airflow',
  'Cooling, power, network & service overlays',
  'Server builder: assemble boxes from components',
  'VPS hosting and bare-metal rentals',
  'Staff with pathfinding, jobs, and maintenance',
  'Contracts, tickets, SLAs, and reputation',
  'Competitors and a hardware marketplace',
  'Deterministic sim with a headless AutoPlayer',
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Data Center Tycoon',
  genre: ['Simulation', 'Tycoon', 'Management'],
  gamePlatform: ['PC', 'Linux', 'Windows'],
  description: 'A systems-heavy data center management sim: design infrastructure, run servers, and grow from a garage to hyperscale while meeting SLAs.',
  author: {
    '@type': 'Person',
    name: 'Shane Kanterman',
    url: 'https://shanekanterman.dev',
  },
};
---

<BaseLayout
  title="Data Center Tycoon — Build it, cool it, keep it up"
  description="A systems-heavy data center management sim. Design power, cooling, and network, run servers, and grow from a garage to hyperscale while meeting SLAs."
  image="/og/datacentertycoon.jpg"
  imageAlt="Data Center Tycoon key art: rows of server racks, cooling units, and technicians"
  structuredData={structuredData}
  theme="dark"
>
  <div class="dct-shell">
    <header class="dct-nav" aria-label="Data Center Tycoon navigation">
      <a class="brand" href="/datacentertycoon" aria-label="Data Center Tycoon home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Data Center Tycoon</span>
      </a>
      <nav aria-label="Page navigation">
        <a href="#gameplay">Gameplay</a>
        <a href="#systems">Systems</a>
        <a class="nav-portfolio" href="/">Shane's portfolio <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="dct-title">
        <div class="hero-copy">
          <p class="status"><span></span> In development · Playtesting now</p>
          <h1 id="dct-title">Build it. Cool it.<br /><em>Keep it up.</em></h1>
          <p class="hero-lede">
            A systems-heavy management sim about running a data center. Lay out the floor, route
            power and cooling, build servers, sell hosting, and grow from a garage to hyperscale
            without missing an SLA.
          </p>
          <div class="hero-actions">
            <a class="dct-button primary" href={playtestUrl}>
              Request playtest access
              <span aria-hidden="true">→</span>
            </a>
            <a class="dct-button secondary" href="#gameplay">See the game <span aria-hidden="true">↓</span></a>
          </div>
          <p class="platform-note">PC · C++20 + SDL2 · Linux first, Windows in progress</p>
        </div>
      </section>

      <figure class="key-art">
        <Image
          src={keyArt}
          alt="Key art: a dark data hall with rows of server racks, large cooling units, blue and yellow cable runs, and technicians in hard hats at work."
          widths={[960, 1600, 2400]}
          sizes="(max-width: 1240px) 100vw, 1240px"
          loading="eager"
        />
      </figure>

      <section class="loop-strip" aria-label="The core loop">
        <p>THE CORE LOOP</p>
        <ol>
          {loop.map((step, index) => (
            <li><span>{index + 1}</span>{step}</li>
          ))}
        </ol>
      </section>

      <section class="pillars section-pad" id="gameplay">
        <div class="section-heading">
          <p class="eyebrow">What you're running</p>
          <h2>A business built on physics.</h2>
          <p>
            Data Center Tycoon is a tycoon game where the infrastructure is the puzzle. Heat,
            watts, and bandwidth decide whether your customers stay.
          </p>
        </div>
        <div class="pillar-grid">
          {pillars.map((pillar) => (
            <article>
              <span class="pillar-number">{pillar.number}</span>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="screens section-pad" aria-labelledby="screens-title">
        <div class="section-heading">
          <p class="eyebrow">In game</p>
          <h2 id="screens-title">Current build.</h2>
          <p>Early-game captures from the native client. The UI is still changing between playtests.</p>
        </div>
        <div class="screen-grid">
          <figure>
            <Image
              src={fieldNoteShot}
              alt="In-game screenshot: a small data hall with a few racks. An inbox email titled 'Field note: racks have a front and a back' explains airflow and how to earn hosting income."
              widths={[640, 1280]}
              sizes="(max-width: 900px) 100vw, 580px"
            />
            <figcaption>Onboarding arrives as ops emails. Here: why racks need clear tiles in front and behind.</figcaption>
          </figure>
          <figure>
            <Image
              src={panelsShot}
              alt="In-game screenshot: the All panels menu, grouping Business (Hosting, Contracts, Marketing, Finances, Bank), Facility, Operations, and Market panels."
              widths={[640, 1280]}
              sizes="(max-width: 900px) 100vw, 580px"
            />
            <figcaption>All panels: hosting, contracts, staff, tickets, competitors, and more, with pinning and search.</figcaption>
          </figure>
        </div>
      </section>

      <section class="details section-pad" id="systems">
        <div class="systems-panel">
          <p class="eyebrow">Under the hood</p>
          <h2>Deep systems, readable at a glance.</h2>
          <ul>
            {systems.map((system) => <li><span>▸</span>{system}</li>)}
          </ul>
        </div>
        <div class="build-panel">
          <div class="build-top">
            <p class="eyebrow">How it's built</p>
            <span>PLAYTEST BUILDS</span>
          </div>
          <div class="overlay-chips" aria-label="Map overlays">
            <span class="cool">Cooling</span><span class="power">Power</span><span class="net">Network</span><span class="svc">Service</span>
          </div>
          <h2>A deterministic sim with a test suite behind it.</h2>
          <p>
            The simulation core is separate from the UI and runs headless, so an AutoPlayer can
            play thousands of in-game days for balance testing. Content is data-driven JSON, and
            every change goes through CI on self-hosted runners before a playtest build ships.
          </p>
          <a href={playtestUrl}>Ask about the next playtest <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="closing section-pad">
        <p class="eyebrow">Your first rack is waiting</p>
        <h2>Five nines<br /><span>or bust.</span></h2>
        <p>Playtest builds go out in small batches. Send me a note if you want in.</p>
        <a class="dct-button primary" href={playtestUrl}>Request playtest access <span aria-hidden="true">→</span></a>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  :global(body) { background: #0a0f16; color: #e8eef6; }
  :global(body::before) { display: none; }
  :global(.site-footer) { background: #070b10; border-color: rgba(110,190,255,.1); color: #6c7d90; }
  :global(.site-footer-build) { color: #7d8ea1; }
  :global(.skip-link) { background: #5fd4ff; color: #0a0f16; }
  .dct-shell { --cyan: #5fd4ff; --amber: #f2c14e; --ink: #e8eef6; --muted: #93a4b8; --line: rgba(120,190,255,.13); --panel: #0e1520; overflow: hidden; background: radial-gradient(circle at 80% 4%, rgba(60,170,255,.16), transparent 26%), radial-gradient(circle at 10% 40%, rgba(242,193,78,.05), transparent 22%), #0a0f16; }
  .dct-nav { width: min(calc(100% - 3rem), 1180px); margin: 0 auto; min-height: 84px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; gap: .75rem; font-size: 1.02rem; font-weight: 800; letter-spacing: -.02em; }
  .brand-mark { width: 30px; height: 30px; padding: 6px 7px; border: 1px solid rgba(95,212,255,.35); border-radius: 7px; display: grid; gap: 3px; background: rgba(95,212,255,.07); }
  .brand-mark i { display: block; height: 3px; border-radius: 1px; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
  .brand-mark i:nth-child(2) { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
  .dct-nav nav { display: flex; align-items: center; gap: 2rem; color: var(--muted); font-size: .86rem; font-weight: 600; }
  .dct-nav nav a:hover { color: var(--ink); }
  .nav-portfolio { padding: .65rem 1rem; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); }
  .hero { width: min(calc(100% - 3rem), 1180px); margin: 0 auto; padding: 6rem 0 3.5rem; }
  .status { display: inline-flex; align-items: center; gap: .6rem; margin: 0 0 1.5rem; color: var(--cyan); font: 700 .72rem/1 var(--font-family-sans); letter-spacing: .14em; text-transform: uppercase; }
  .status span { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 14px var(--amber); animation: blink 1.6s steps(2, start) infinite; }
  .hero h1 { max-width: 900px; margin: 0; color: var(--ink); font-family: var(--font-family-sans); font-size: clamp(3.1rem, 7vw, 6.2rem); font-weight: 750; line-height: .98; letter-spacing: -.06em; }
  .hero h1 em { color: var(--cyan); font-style: normal; text-shadow: 0 0 45px rgba(95,212,255,.25); }
  .hero-lede { max-width: 660px; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.14rem); line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.1rem; }
  .dct-button { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: .7rem; padding: .75rem 1.25rem; border-radius: 9px; border: 1px solid transparent; font-weight: 750; font-size: .91rem; transition: transform 160ms ease, background 160ms ease; }
  .dct-button:hover { transform: translateY(-2px); }
  .dct-button.primary { color: #071018; background: var(--cyan); box-shadow: 0 0 30px rgba(95,212,255,.14); }
  .dct-button.primary:hover { background: #95e3ff; }
  .dct-button.secondary { color: var(--ink); border-color: var(--line); background: rgba(255,255,255,.025); }
  .platform-note { margin: 1.15rem 0 0; color: #7d8ea1; font-size: .76rem; }
  .key-art { width: min(calc(100% - 3rem), 1240px); margin: 0 auto 4rem; overflow: hidden; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 35px 90px rgba(0,0,0,.5), 0 0 80px rgba(60,170,255,.08); }
  .key-art img { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .loop-strip { border-block: 1px solid var(--line); background: rgba(255,255,255,.018); padding: 1.6rem max(1.5rem, calc((100vw - 1180px)/2)); display: flex; align-items: center; gap: 2.5rem; }
  .loop-strip > p, .eyebrow { color: var(--amber); font-size: .68rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .loop-strip > p { margin: 0; flex: none; }
  .loop-strip ol { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.4rem; margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: .8rem; }
  .loop-strip li { display: flex; align-items: center; gap: .45rem; }
  .loop-strip li span { display: grid; place-items: center; width: 22px; height: 22px; border: 1px solid var(--line); border-radius: 50%; color: var(--cyan); font-size: .63rem; }
  .section-pad { width: min(calc(100% - 3rem), 1180px); margin: 0 auto; padding: 7rem 0; }
  .section-heading { max-width: 710px; }
  .eyebrow { margin: 0 0 1.2rem; }
  .section-heading h2, .details h2, .closing h2 { margin: 0; color: var(--ink); font-family: var(--font-family-sans); font-size: clamp(2.3rem, 4.5vw, 4rem); line-height: 1.05; letter-spacing: -.05em; }
  .section-heading > p:last-child { max-width: 610px; margin: 1.4rem 0 0; color: var(--muted); line-height: 1.75; }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 4rem; border-block: 1px solid var(--line); }
  .pillar-grid article { padding: 2.3rem 2.3rem 2.3rem 0; transition: background 180ms ease, transform 180ms ease; }
  .pillar-grid article:hover { transform: translateY(-6px); background: linear-gradient(180deg, rgba(95,212,255,.04), transparent); }
  .pillar-grid article + article { padding-left: 2.3rem; border-left: 1px solid var(--line); }
  .pillar-number { color: var(--cyan); font: 700 .62rem/1 ui-monospace, monospace; letter-spacing: .08em; }
  .pillar-grid h3 { margin: 3rem 0 .9rem; color: var(--ink); font-family: var(--font-family-sans); font-size: 1.15rem; }
  .pillar-grid p { margin: 0; color: var(--muted); line-height: 1.7; font-size: .9rem; }
  .screens { padding-top: 0; }
  .screen-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 3rem; }
  .screen-grid figure { margin: 0; }
  .screen-grid img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 24px 60px rgba(0,0,0,.4); }
  .screen-grid figcaption { margin-top: .9rem; color: var(--muted); font-size: .82rem; line-height: 1.6; }
  .details { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; padding: 0; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--line); }
  .details > div { padding: clamp(2rem, 5vw, 4rem); background: var(--panel); }
  .details h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .systems-panel ul { margin: 2.4rem 0 0; padding: 0; list-style: none; }
  .systems-panel li { display: flex; gap: .7rem; padding: .8rem 0; border-top: 1px solid var(--line); color: #b9c7d6; font-size: .84rem; line-height: 1.45; }
  .systems-panel li span { color: var(--cyan); }
  .build-top { display: flex; align-items: center; justify-content: space-between; }
  .build-top > span { color: var(--cyan); font-size: .7rem; font-weight: 700; }
  .overlay-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin: .4rem 0 1.8rem; }
  .overlay-chips span { display: inline-flex; align-items: center; gap: .45rem; padding: .5rem .8rem; border: 1px solid var(--line); border-radius: 999px; color: #c6d3e0; background: #0a1019; font-size: .72rem; font-weight: 700; }
  .overlay-chips span::before { content: ''; width: 7px; height: 7px; border-radius: 50%; }
  .overlay-chips .cool::before { background: #4cc9f0; }
  .overlay-chips .power::before { background: #f2c14e; }
  .overlay-chips .net::before { background: #4ade80; }
  .overlay-chips .svc::before { background: #c084fc; }
  .build-panel > p:not(.eyebrow) { margin: 1.3rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.75; }
  .build-panel > a { display: inline-flex; gap: .5rem; margin-top: 2.3rem; color: var(--cyan); font-size: .84rem; font-weight: 700; }
  .closing { text-align: center; padding-block: 10rem; }
  .closing h2 span { color: var(--cyan); }
  .closing > p:not(.eyebrow) { margin: 1.5rem auto 2.2rem; color: var(--muted); }
  @keyframes blink { to { opacity: .35; } }
  @media (prefers-reduced-motion: reduce) { .status span { animation: none; } }
  @media (max-width: 900px) {
    .loop-strip { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .pillar-grid { grid-template-columns: 1fr; }
    .pillar-grid article, .pillar-grid article + article { padding: 2rem 0; border-left: 0; border-top: 1px solid var(--line); }
    .pillar-grid article:first-child { border-top: 0; }
    .pillar-grid h3 { margin-top: 1.6rem; }
    .screen-grid, .details { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .dct-nav, .hero, .section-pad, .key-art { width: min(calc(100% - 2rem), 1180px); }
    .dct-nav nav > a:not(.nav-portfolio) { display: none; }
    .brand > span:last-child { font-size: .92rem; }
    .nav-portfolio { padding: .55rem .8rem; }
    .hero { padding-block: 4rem 2.5rem; }
    .hero h1 { font-size: clamp(2.6rem, 13vw, 4rem); }
    .section-pad { padding-block: 5rem; }
    .details > div { padding: 2rem 1.4rem; }
  }
  @media (pointer: coarse) {
    .brand { padding-block: .5rem; }
    .build-panel > a { padding-block: .75rem; }
  }
</style>
