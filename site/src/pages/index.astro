---
import AnimatedSection from '../components/AnimatedSection.astro';
import ArchitectureSnapshot from '../components/ArchitectureSnapshot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/GlassCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import SectionIntro from '../components/SectionIntro.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StackBadge from '../components/StackBadge.astro';
import SystemConstellation from '../components/SystemConstellation.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);
const portfolioProjects = sorted.filter((project) => project.data.kind === 'project');
const featuredProject = portfolioProjects.find((project) => project.data.featured)!;
const supportingProjects = portfolioProjects.filter((project) => !project.data.featured);
const dataCenterExperience = sorted.find((entry) => entry.data.kind === 'experience')!;

const navItems = [
  { label: 'Projects', href: '#projects' },
  { label: 'Experience', href: '#about' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];

const capabilityGroups = [
  {
    name: 'Systems and Networking',
    description: 'Provision, connect, and troubleshoot Linux systems across physical and virtual infrastructure.',
    items: ['Linux', 'Proxmox', 'Nginx', 'Caddy', 'Cloudflare', 'Tailscale', 'PXE Boot'],
  },
  {
    name: 'Platform and Delivery',
    description: 'Build repeatable delivery paths with isolated CI, container workflows, health checks, and rollback.',
    items: ['GitHub Actions', 'k3s', 'ARC', 'Docker', 'GHCR', 'Atomic Releases'],
  },
  {
    name: 'Software and Data',
    description: 'Write the application and automation code that makes infrastructure practical to operate.',
    items: ['Rust', 'TypeScript', 'Next.js', 'Python', 'PostgreSQL', 'Git', 'Astro'],
  },
];

// Fragments, not sentences. This panel is the fastest read on the page and
// shares the fold with the headline — anything that wraps past two lines
// stops being a glance and starts being a paragraph.
const systemSummary = [
  { label: 'Operations', value: 'Rack, image, and troubleshoot production servers' },
  { label: 'Platform', value: 'Two-site Proxmox estate, public and private zones' },
  { label: 'Delivery', value: 'Ephemeral CI, atomic releases, rollback retained' },
  { label: 'Product', value: 'Rust and Next.js deploy tooling for self-hosted apps' },
];

const heroMetrics = [
  { value: '2 sites', label: 'Proxmox platform' },
  { value: '1–3 runners', label: 'Ephemeral CI capacity' },
  { value: 'Rust + Next.js', label: 'Hostlet control plane' },
];

const profilePoints = [
  'Rack-and-stack and server deployment experience',
  'Linux administration and troubleshooting background',
  'Self-hosted systems for development, backups, and web app hosting',
];

const certifications = [
  {
    name: 'Technical Support Fundamentals',
    issuer: 'Google / Coursera',
    date: 'June 2025',
    credentialId: '5BHVX4W2WMD5',
  },
];

const [topCertification] = certifications;

const timelineEntries = [
  {
    date: 'June 2025 – Present',
    org: 'InterServer — Secaucus, NJ',
    title: 'Data Center Technician',
    body:
      'Live data center work: rack-and-stack, OS installs (Linux, Windows, Proxmox), PXE imaging, hardware diagnostics, and deployment documentation.',
    href: `/projects/${dataCenterExperience.id}`,
    linkLabel: 'Read experience notes',
  },
  {
    date: 'Sept. 2023 – May 2027',
    org: 'Southern Connecticut State University',
    title: 'Computer Science Student',
    body:
      'Building skills in software engineering, operating systems, and networking. Active member of the university football program.',
    href: '',
    linkLabel: '',
  },
  {
    date: topCertification.date,
    org: `${topCertification.issuer} · Certification`,
    title: topCertification.name,
    body: `Credential ${topCertification.credentialId}`,
    href: '',
    linkLabel: '',
  },
];

const githubUrl = 'https://github.com/ShaneKanterman04';
const linkedInUrl = 'https://www.linkedin.com/in/shane-kanterman-4511a2234';
const emailUrl = 'mailto:shanekanterman04@gmail.com';

const siteUrl = Astro.site?.toString() ?? 'https://shanekanterman.dev';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Shane Kanterman',
    url: siteUrl,
      description:
        'Infrastructure and platform portfolio for Shane Kanterman featuring Linux systems, deployment tooling, ephemeral CI, and hands-on data center operations.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Shane Kanterman',
    url: siteUrl,
    sameAs: [linkedInUrl, githubUrl],
    email: 'mailto:shanekanterman04@gmail.com',
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Southern Connecticut State University',
    },
    knowsAbout: [
      'Linux administration',
      'Platform engineering',
      'Deployment automation',
      'Continuous integration',
      'Server deployment',
      'Data center operations',
      'Network infrastructure',
      'Proxmox',
      'Kubernetes',
      'Docker',
      'Rust',
      'Nginx',
    ],
    jobTitle: 'Data Center Technician',
  },
];
---

<BaseLayout
  title="Shane Kanterman | Infrastructure and Platform Projects"
  description="Infrastructure and platform portfolio for Shane Kanterman featuring Linux systems, deployment tooling, ephemeral CI, and hands-on data center operations."
  image="/og/portfolio-preview-2026.png"
  imageAlt="Shane Kanterman portfolio preview"
  structuredData={structuredData}
  chatEnabled={true}
>
  <SystemConstellation />
  <div class="page-shell editorial-shell relative z-10 pb-10">
    <SiteHeader home={true} navItems={navItems} />

    <main class="pt-8" id="main-content">
      <section
        class="hero-surface grid grid-cols-[minmax(0,1.1fr)_minmax(19rem,25rem)] gap-12 items-start pt-14 pb-20 max-[960px]:grid-cols-1 max-[960px]:gap-8 max-[960px]:pt-8 max-[960px]:pb-10 max-[780px]:pt-4 max-[780px]:pb-8"
        id="top"
      >
        <div>
          <p class="eyebrow hero-reveal hero-reveal-1">
            Computer Science Student &middot; Data Center Technician
          </p>
          <h1
            class="hero-reveal hero-reveal-2 mb-6 max-w-[24ch] font-extrabold overflow-wrap-break-word text-text-base"
          >
            {/* A comma, not an em dash: a break is permitted after an em dash,
                so at narrow widths the dash wraps to the head of the next
                line. A comma can never start a line. */}
            I build Linux platforms, <span class="gradient-text">from bare metal to CI/CD.</span>
          </h1>
          <p class="hero-reveal hero-reveal-3 text-text-muted leading-[1.7] text-[1.08rem] max-w-[36rem]">
            Data Center Technician at InterServer and a CS student at SCSU. I provision
            production hardware at work, and build the Linux platform, CI, and deployment
            tooling that runs my own two-site Proxmox estate.
          </p>

          <div class="hero-reveal hero-reveal-4 flex flex-wrap gap-4 mt-8 max-[780px]:flex-col max-[780px]:items-stretch">
            <a class="btn btn-primary" href="#projects">
              View Selected Work
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <path d="M7 17L17 7" />
                <path d="M9 7h8v8" />
              </svg>
            </a>
            <a
              class="btn btn-secondary"
              href={linkedInUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
            <a
              class="btn btn-secondary"
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          </div>
        </div>

        <GlassCard class="hero-reveal hero-reveal-5 sticky top-28 flex flex-col gap-8 p-8 max-[960px]:static" hover={false}>
          <div>
            <h2 class="mb-4 field-label">
              Proof at a glance
            </h2>
            <ul class="grid gap-4 p-0 list-none">
              {systemSummary.map((item) => (
                <li class="system-summary-row">
                  <span class="system-summary-label">{item.label}</span>
                  <span class="system-summary-copy">{item.value}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="grid gap-2.5 pt-5 border-t border-line">
            {heroMetrics.map((metric) => (
              <div class="flex justify-between items-baseline gap-4 overflow-wrap-break-word">
                <span class="text-[1.05rem] font-bold text-text-base leading-snug shrink-0">
                  {metric.value}
                </span>
                <span class="text-[0.82rem] text-text-soft leading-snug text-right">
                  {metric.label}
                </span>
              </div>
            ))}
          </div>
        </GlassCard>
      </section>

      <AnimatedSection
        id="projects"
        delay={1}
      >
        <SectionIntro
          eyebrow="Selected work"
          title="Platforms and delivery systems built for real operation."
          body="These case studies focus on the boundaries, failure modes, and release decisions behind the work—not just the finished interface."
        />

        <div class="project-collection">
          <ProjectShowcase project={featuredProject} />

          <div class="project-card-grid">
            {supportingProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </AnimatedSection>

      <AnimatedSection
        id="about"
        delay={1}
      >
        <SectionIntro
          eyebrow="Experience"
          title="From production hardware to platform delivery."
          body="Physical infrastructure work shaped how I approach software: keep systems understandable, deploy them cleanly, and plan for how they fail."
        />

        <GlassCard
          class="panel-split p-8 max-[780px]:p-6"
          style="--panel-split-cols: minmax(0,1.55fr) minmax(0,1fr)"
          hover={false}
        >
          <div>
            <p class="text-text-muted leading-[1.75] text-[1.04rem]">
              CS student at SCSU and Data Center Technician at InterServer. Experience in
              rack-and-stack, PXE boot imaging, Linux administration, and hardware troubleshooting
              in a live production environment.
            </p>
            <p class="text-text-muted leading-[1.75] text-[1.04rem] mt-4">
              That background changed how I evaluate software work: not only what gets built, but
              how it is deployed, operated, and kept reliable over time.
            </p>
            <p class="text-text-muted leading-[1.75] text-[1.04rem] mt-4">
              I prefer simple, reliable systems with clear deployment paths. I care about how
              software fails, how it is maintained, and how its infrastructure can stay lean
              without sacrificing reliability.
            </p>
          </div>

          <div>
            <h3 class="field-label mb-4">
              What that looks like in practice
            </h3>
            <ul class="grid gap-3 p-0 list-none">
              {profilePoints.map((point) => (
                <li class="relative pl-5 text-text-muted leading-[1.6] text-[0.95rem]">
                  <span
                    class="profile-point-dot absolute left-0 top-[0.72rem] -translate-y-1/2 w-1.5 h-1.5 rounded-full"
                    aria-hidden="true"
                  ></span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </GlassCard>

        <GlassCard class="p-8 max-[780px]:p-6 mt-9 max-[780px]:mt-6" hover={false}>
          <h3 class="field-label mb-6">
            Track record
          </h3>
          <ol class="timeline">
            {timelineEntries.map((entry) => (
              <li class="timeline-entry">
                <p class="timeline-date">{entry.date}</p>
                <div class="timeline-body">
                  <p class="field-label">{entry.org}</p>
                  <h4 class="timeline-title">{entry.title}</h4>
                  <p class="timeline-copy">{entry.body}</p>
                  {entry.href && (
                    <a class="text-link w-fit text-[0.9rem]" href={entry.href}>
                      {entry.linkLabel}
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </GlassCard>
      </AnimatedSection>

      <AnimatedSection
        id="architecture"
        delay={1}
      >
        <SectionIntro
          eyebrow="Architecture"
          title="A portfolio site backed by real deployment decisions."
          body="The application layer is intentionally simple. The interesting work is in private origin isolation, shared edge routing, verified TLS, atomic delivery, and recovery."
        />

        <GlassCard
          class="panel-split p-8 max-[780px]:p-6"
          style="--panel-split-cols: minmax(0,1fr) minmax(20rem,26rem)"
          hover={false}
        >
          <div>
            <h3 class="mb-3 field-label">
              Why it stands out
            </h3>
            <p class="text-text-muted leading-[1.75] text-[1.04rem] m-0">
              Instead of stopping at a static frontend, this site separates public ingress from
              a private origin and deploys commit-addressed releases with automated rollback.
            </p>

            <div class="architecture-proof-rows">
              <div class="proof-inline-row">
                <span class="project-proof-label">Edge services</span>
                <span class="project-proof-copy">Cloudflare and Caddy provide DNS, TLS, headers, and routing.</span>
              </div>
              <div class="proof-inline-row">
                <span class="project-proof-label">Origin</span>
                <span class="project-proof-copy">A private unprivileged LXC keeps the workload off the edge VM.</span>
              </div>
              <div class="proof-inline-row">
                <span class="project-proof-label">Delivery</span>
                <span class="project-proof-copy">GitHub Actions validates and atomically activates each release.</span>
              </div>
            </div>
          </div>

          <div>
            <ArchitectureSnapshot />
          </div>
        </GlassCard>
      </AnimatedSection>

      <AnimatedSection
        id="skills"
        delay={1}
      >
        <SectionIntro
          eyebrow="Skills"
          title="Skills used to build, deploy, and maintain systems."
          body="These are the tools and workflows I use across application work, Linux administration, deployment, and troubleshooting."
        />

        <div class="grid grid-cols-3 gap-5 min-[960px]:gap-7 max-[960px]:grid-cols-2 max-[580px]:grid-cols-1">
          {capabilityGroups.map((group) => (
            <GlassCard
              class="grid content-start gap-4 p-8 min-h-full overflow-wrap-break-word min-w-0 max-[780px]:p-6"
              hover={true}
            >
              <h3 class="field-label">
                {group.name}
              </h3>
              <p class="text-text-muted leading-[1.65] text-[0.95rem]">{group.description}</p>
              <div class="stack-list">
                {group.items.map((item) => (
                  <StackBadge label={item} />
                ))}
              </div>
            </GlassCard>
          ))}
        </div>
      </AnimatedSection>

      <AnimatedSection
        id="contact"
        delay={1}
      >
        <GlassCard
          class="panel-split contact-panel p-8 max-[780px]:p-6"
          style="--panel-split-cols: minmax(0,1.6fr) minmax(15rem,18rem)"
          hover={false}
        >
          <div>
            <p class="eyebrow">
              Contact
            </p>
            <h2
              class="text-[length:var(--step-title)] leading-[1.08] tracking-[-0.02em] mb-5 font-extrabold text-text-base"
            >
              Early-career infrastructure and platform roles.
            </h2>
            <p class="text-text-muted leading-[1.75] text-[1.04rem]">
              Most interested in work where Linux systems, networking, deployment automation,
              and software delivery share the same operational owner.
            </p>

            <dl class="contact-details">
              <dt class="field-label">Email</dt>
              <dd>shanekanterman04@gmail.com</dd>
              <dt class="field-label">Based in</dt>
              <dd>Cranford, NJ and New Haven, CT</dd>
            </dl>
          </div>

          <div class="contact-link-grid min-w-[12rem] max-[780px]:w-full">
            <a
              class="btn btn-primary max-[780px]:w-full"
              href={emailUrl}
            >
              Email me
            </a>
            <a
              class="btn btn-secondary max-[780px]:w-full"
              href={linkedInUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
            <a
              class="btn btn-secondary max-[780px]:w-full"
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          </div>
        </GlassCard>
      </AnimatedSection>

    </main>
  </div>

  <script>
    const sectionIds = ['projects', 'about', 'architecture', 'skills', 'contact'];
    const sectionLinks = Array.from(document.querySelectorAll('[data-nav-link]'));

    const setActiveSection = (sectionId) => {
      sectionLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-link') === sectionId;
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visibleEntries = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

          if (visibleEntries.length > 0) {
            setActiveSection(visibleEntries[0].target.id);
          }
        },
        {
          rootMargin: '-35% 0px -45% 0px',
          threshold: [0.2, 0.4, 0.6],
        },
      );

      sectionIds.forEach((id) => {
        const section = document.getElementById(id);
        if (section) observer.observe(section);
      });
    }
  </script>
</BaseLayout>
