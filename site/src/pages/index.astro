---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyDetails from '../components/CaseStudyDetails.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import RackElevation from '../components/RackElevation.astro';
import RepoPlates from '../components/RepoPlates.astro';
import Sheet from '../components/Sheet.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getCollection } from 'astro:content';
import { KANTERLABS_ORG_URL } from '../lib/kanterlabs';
import { leadUnit } from '../lib/rack';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);
const portfolioProjects = sorted.filter((project) => project.data.kind === 'project');
const dataCenterExperience = sorted.find((entry) => entry.data.kind === 'experience')!;

const navItems = [
  { label: 'Rack', href: '#kanterlabs' },
  { label: 'Case studies', href: '#projects' },
  { label: 'Experience', href: '#about' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];

const SHEET_COUNT = 6;
const lastDetailLetter = String.fromCharCode(64 + portfolioProjects.length);

const capabilityGroups = [
  {
    name: 'Systems and Networking',
    description: 'Provision, connect, and troubleshoot Linux systems across physical and virtual infrastructure.',
    items: ['Linux', 'Proxmox', 'Nginx', 'Caddy', 'Cloudflare', 'Tailscale', 'PXE Boot'],
  },
  {
    name: 'Platform and Delivery',
    description: 'Build repeatable delivery paths with isolated CI, container workflows, health checks, and rollback.',
    items: ['GitHub Actions', 'k3s', 'ARC', 'Docker', 'GHCR', 'Coolify', 'Atomic Releases'],
  },
  {
    name: 'Software and Data',
    description: 'Write the application and automation code that makes infrastructure practical to operate.',
    items: ['Rust', 'TypeScript', 'Next.js', 'Python', 'PostgreSQL', 'Git', 'Astro'],
  },
];

const profilePoints = [
  'Rack-and-stack and server deployment experience',
  'Linux administration and troubleshooting background',
  'Self-hosted systems for development, backups, and web app hosting',
];

const certifications = [
  {
    name: 'Technical Support Fundamentals',
    issuer: 'Google / Coursera',
    date: 'June 2025',
    credentialId: '5BHVX4W2WMD5',
  },
];

const [topCertification] = certifications;

const timelineEntries = [
  {
    date: 'June 2025 – Present',
    org: 'InterServer — Secaucus, NJ',
    title: 'Data Center Technician',
    body:
      'Live data center work: server builds and hardware mods, rack-and-stack, OS installs (Linux, Windows, Proxmox), hardware diagnostics, decommissioning, an ongoing ~72-rack data center buildout, and PXE imaging.',
    href: `/projects/${dataCenterExperience.id}`,
    linkLabel: 'Read experience notes',
  },
  {
    date: 'Sept. 2023 – May 2027',
    org: 'Southern Connecticut State University',
    title: 'Computer Science Student',
    body:
      'Building skills in software engineering, operating systems, and networking.',
    href: '',
    linkLabel: '',
  },
  {
    date: topCertification.date,
    org: `${topCertification.issuer} · Certification`,
    title: topCertification.name,
    body: `Credential ${topCertification.credentialId}`,
    href: '',
    linkLabel: '',
  },
];

const personalGithubUrl = 'https://github.com/ShaneKanterman04';
const linkedInUrl = 'https://www.linkedin.com/in/shane-kanterman-4511a2234';
const emailUrl = 'mailto:shanekanterman04@gmail.com';

// The rack's patch panel. No résumé link: the site deliberately doesn't
// publish one (tests/home.spec.ts).
const contactLinks = [
  { label: 'Email', href: emailUrl },
  { label: 'LinkedIn', href: linkedInUrl, external: true },
  { label: 'GitHub', href: KANTERLABS_ORG_URL, external: true },
  { label: 'Personal GitHub', href: personalGithubUrl, external: true },
];

const siteUrl = Astro.site?.toString() ?? 'https://shanekanterman.dev';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Shane Kanterman',
    url: siteUrl,
    description:
      'Portfolio of Shane Kanterman, a Data Center Technician at InterServer, featuring production server operations, Linux systems, deployment tooling, and infrastructure projects.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Shane Kanterman',
    url: siteUrl,
    sameAs: [linkedInUrl, KANTERLABS_ORG_URL, personalGithubUrl],
    email: 'mailto:shanekanterman04@gmail.com',
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Southern Connecticut State University',
    },
    knowsAbout: [
      'Linux administration',
      'Platform engineering',
      'Deployment automation',
      'Continuous integration',
      'Server deployment',
      'Data center operations',
      'Network infrastructure',
      'Proxmox',
      'Kubernetes',
      'Docker',
      'Rust',
      'Nginx',
    ],
    jobTitle: 'Data Center Technician',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'KanterLabs',
    url: KANTERLABS_ORG_URL,
    logo: new URL('/apple-touch-icon.png', siteUrl).toString(),
    description:
      'Independent product and infrastructure studio building developer tools, self-hosted platforms, and practical software.',
    founder: { '@type': 'Person', name: 'Shane Kanterman', url: siteUrl },
    sameAs: [KANTERLABS_ORG_URL],
  },
];
---
<BaseLayout
  title="Shane Kanterman | Data Center Technician and Infrastructure Work"
  description="Portfolio of Shane Kanterman, a Data Center Technician at InterServer, featuring production server operations, Linux systems, deployment tooling, and infrastructure projects."
  socialTitle="Shane Kanterman | Data Center Technician"
  socialDescription="Hands-on data center work at InterServer: rack-and-stack, cabling, server builds, and hardware troubleshooting."
  image="/og/portfolio-rack-v2.png"
  imageAlt="Shane Kanterman, Data Center Technician. Rack-and-stack, cabling, hardware, and production systems at InterServer, beside a large server rack."
  structuredData={structuredData}
  chatEnabled={true}
>
  <div class="page-shell relative z-10 pb-10">
    <SiteHeader home={true} navItems={navItems} />

    <main class="pt-6 max-[780px]:pt-1" id="main-content">
      <Sheet
        id="top"
        sheet={1}
        of={SHEET_COUNT}
        label="Rack elevation"
        drawing="KanterLabs / DWG SK-01"
        animate={false}
        class="hero-sheet"
      >
        <div class="hero-grid">
          <div class="hero-intro">
            <p class="dwg-label hero-tag">Shane Kanterman · Data center technician</p>
            {/* A comma, not an em dash: a break is permitted after an em dash,
                so at narrow widths the dash wraps to the head of the next
                line. A comma can never start a line. */}
            <h1 class="hero-title">
              <span class="hero-title-line">Everything I run,</span> <span class="dwg-serif">in one rack.</span>
            </h1>
            <p class="hero-copy">
              I build, rack, image, and decommission production servers at InterServer. Everything
              I build on my own time ships from KanterLabs, my open-source studio, and this is the
              elevation drawing of it. Pick a unit to open it.
            </p>
            <div class="hero-actions">
              <a class="dwg-btn dwg-btn-primary" href={leadUnit.href}>
                Open detail A: {leadUnit.repo.name}
                <span aria-hidden="true">→</span>
              </a>
              <a class="dwg-btn" href={`/projects/${dataCenterExperience.id}`}>
                Data center work
              </a>
              <a class="dwg-btn kl-btn-github" href={KANTERLABS_ORG_URL} target="_blank" rel="noopener noreferrer">
                <GitHubIcon size={17} />
                <span><span class="max-[780px]:sr-only">KanterLabs on </span>GitHub</span>
              </a>
            </div>
          </div>
          <RackElevation id="kanterlabs" contactLinks={contactLinks} />
          <table class="dwg-table hero-facts">
            <caption class="dwg-label">A few things about me</caption>
            <tbody>
              <tr>
                <th scope="row">Hands-on work</th>
                <td>I’m helping rack and wire an ongoing buildout of roughly 72 racks at InterServer.</td>
              </tr>
              <tr>
                <th scope="row">Built for my own work</th>
                <td>I built Helm and use it to track the work my coding agents do.</td>
              </tr>
              <tr>
                <th scope="row">Beyond the rack</th>
                <td>I study computer science at Southern Connecticut State, with graduation expected in May 2027.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </Sheet>

      <Sheet
        id="projects"
        sheet={2}
        of={SHEET_COUNT}
        label="Case studies"
        drawing={`DWG SK-02 · Details A–${lastDetailLetter}`}
        labelledBy="projects-title"
      >
        <h2 class="sheet-title" id="projects-title">Detail drawings of systems that run.</h2>
        <p class="sheet-intro">
          Every case study opens with its drawing: the boundaries, failure modes, and release
          decisions behind the work, not just the finished interface.
        </p>

        <CaseStudyDetails projects={portfolioProjects} />
      </Sheet>

      <Sheet
        id="plates"
        sheet={3}
        of={SHEET_COUNT}
        label="Plates · flagship units"
        drawing="DWG SK-03 · Plates 1–5"
        labelledBy="plates-title"
      >
        <h2 class="sheet-title" id="plates-title">The flagship units, photographed.</h2>
        <p class="sheet-intro">
          Real screenshots and recordings of the larger units in the rack, keyed to their callout
          numbers. Every plate links straight to its source on GitHub.
        </p>
        <RepoPlates />
      </Sheet>

      <Sheet
        id="about"
        sheet={4}
        of={SHEET_COUNT}
        label="Experience"
        drawing="DWG SK-04 · Unit P"
        labelledBy="about-title"
      >
        <h2 class="sheet-title" id="about-title">Hands-on in a live data center.</h2>
        <p class="sheet-intro">
          The solid unit at the bottom of the rack. At InterServer I work directly with the
          production hardware and deployment workflows that reliable infrastructure depends on.
        </p>
        <div class="experience-grid">
          <div class="dwg-box experience-unit">
            <p class="dwg-label">Unit P · power · InterServer, Secaucus NJ</p>
            <h3 class="detail-title">Data Center Technician</h3>
            <p class="detail-summary">
              Server builds and hardware mods, rack-and-stack, Linux administration, hardware
              troubleshooting, and PXE imaging in a live production environment. I am also
              finishing a Computer Science degree at SCSU.
            </p>
            <p class="detail-summary">
              That background changed how I judge software: not only what gets built, but how it is
              deployed, operated, and kept reliable over time.
            </p>
            <ul class="general-notes general-notes-bullets">
              {profilePoints.map((point) => <li>{point}</li>)}
            </ul>
            <a class="text-link detail-more" href={`/projects/${dataCenterExperience.id}`}>
              Read experience notes
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <table class="dwg-table revision-table">
            <caption class="dwg-label">Revision history</caption>
            <thead>
              <tr><th scope="col">Rev</th><th scope="col">Date</th><th scope="col">Description</th></tr>
            </thead>
            <tbody>
              {timelineEntries.map((entry, index) => (
                <tr>
                  <td>{String.fromCharCode(64 + timelineEntries.length - index)}</td>
                  <td class="dwg-nowrap">{entry.date}</td>
                  <td>
                    <strong class="revision-title">{entry.title}</strong>
                    <span class="revision-org">{entry.org}</span>
                    {entry.body}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Sheet>

      <Sheet
        id="skills"
        sheet={5}
        of={SHEET_COUNT}
        label="Bill of materials"
        drawing="DWG SK-05 · BOM"
        labelledBy="skills-title"
      >
        <h2 class="sheet-title" id="skills-title">Skills used to build, deploy, and maintain systems.</h2>
        <p class="sheet-intro">
          The parts list behind the rack: the tools and workflows I use across application work,
          Linux administration, deployment, and troubleshooting.
        </p>
        <div class="bom-scroll">
          <table class="dwg-table bom-table">
            <caption class="sr-only">Bill of materials: skills by assembly</caption>
            <thead>
              <tr><th scope="col">Item</th><th scope="col">Assembly</th><th scope="col">Parts</th><th scope="col">Used for</th></tr>
            </thead>
            <tbody>
              {capabilityGroups.map((group, index) => (
                <tr>
                  <td>{String(index + 1).padStart(2, '0')}</td>
                  <th scope="row">{group.name}</th>
                  <td>
                    <ul class="bom-parts">
                      {group.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </td>
                  <td>{group.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Sheet>

      <Sheet
        id="contact"
        sheet={6}
        of={SHEET_COUNT}
        label="Title block · contact"
        drawing="DWG SK-06"
        labelledBy="contact-title"
      >
        <div class="contact-grid">
          <div>
            <h2 class="sheet-title" id="contact-title">Data center and infrastructure roles.</h2>
            <p class="sheet-intro">
              Most interested in work where production operations, Linux systems, networking,
              deployment automation, and software delivery share the same operational owner.
            </p>
            <div class="detail-actions">
              <a class="dwg-btn dwg-btn-primary" href={emailUrl}>Email me</a>
              <a class="dwg-btn" href={linkedInUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a class="dwg-btn kl-btn-github" href={KANTERLABS_ORG_URL} target="_blank" rel="noopener noreferrer">
                <GitHubIcon size={17} />
                <span><span class="max-[780px]:sr-only">KanterLabs on </span>GitHub</span>
              </a>
            </div>
          </div>
          <dl class="title-block contact-title-block">
            <div class="tb-wide">
              <dt>Drawn by</dt>
              <dd class="tb-name">Shane Kanterman</dd>
            </div>
            <div><dt>Role</dt><dd>Data Center Technician, InterServer</dd></div>
            <div><dt>Studio</dt><dd><a href={KANTERLABS_ORG_URL} target="_blank" rel="noopener noreferrer">KanterLabs</a></dd></div>
            <div class="tb-wide"><dt>Email</dt><dd><a href={emailUrl}>shanekanterman04@gmail.com</a></dd></div>
            <div class="tb-wide"><dt>Based in</dt><dd>Cranford, NJ and New Haven, CT</dd></div>
            <div><dt>LinkedIn</dt><dd><a href={linkedInUrl} target="_blank" rel="noopener noreferrer">/in/shane-kanterman</a></dd></div>
            <div><dt>Personal GitHub</dt><dd><a href={personalGithubUrl} target="_blank" rel="noopener noreferrer">ShaneKanterman04</a></dd></div>
            <div><dt>Sheet</dt><dd>06 of 06</dd></div>
            <div><dt>Scale</dt><dd>1:1</dd></div>
          </dl>
        </div>
      </Sheet>
    </main>
  </div>

  <script>
    const sectionIds = ['kanterlabs', 'projects', 'about', 'skills', 'contact'];
    const sectionLinks = Array.from(document.querySelectorAll('[data-nav-link]'));

    const setActiveSection = (sectionId) => {
      sectionLinks.forEach((link) => {
        const isActive = link.getAttribute('data-nav-link') === sectionId;
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visibleEntries = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

          if (visibleEntries.length > 0) {
            setActiveSection(visibleEntries[0].target.id);
          }
        },
        {
          rootMargin: '-35% 0px -45% 0px',
          threshold: [0.2, 0.4, 0.6],
        },
      );

      sectionIds.forEach((id) => {
        const section = document.getElementById(id);
        if (section) observer.observe(section);
      });
    }
  </script>
</BaseLayout>
