---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const siteUrl = Astro.site?.toString() ?? 'https://shanekanterman.dev';
const pageUrl = new URL('/404/', siteUrl).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Page Not Found',
  description: 'Custom 404 page for Shane Kanterman portfolio site.',
  url: pageUrl,
};
---

<BaseLayout
  title="Page Not Found | Shane Kanterman"
  description="The page you requested could not be found. Browse infrastructure and web project case studies instead."
  structuredData={structuredData}
>
  <div class="page-shell relative z-10 pb-24">
    <SiteHeader backHref="/" backLabel="Home" />

    <main id="main-content" class="pt-10 max-[780px]:pt-6 min-h-[60vh]">
      <div class="max-w-[42rem]">
        <p class="eyebrow">404</p>
        <h1 class="text-[length:var(--step-title)] leading-[1.05] tracking-[-0.02em] mb-5 font-extrabold text-text-base">
          Page not found.
        </h1>
        <p class="text-text-muted leading-[1.75] text-[1.04rem] mb-8 max-w-[34rem]">
          The page you requested is not here. You can return to the portfolio homepage, review project case studies, or connect on LinkedIn.
        </p>
        <div class="flex flex-wrap gap-4 max-[640px]:flex-col max-[640px]:items-stretch">
          <a class="btn btn-primary" href="/">Go home</a>
          <a class="btn btn-secondary" href="/#projects">View projects</a>
          <a class="btn btn-secondary" href="https://www.linkedin.com/in/shane-kanterman-4511a2234" target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
