---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandRabbit from '../components/BrandRabbit.astro';
import Sheet from '../components/Sheet.astro';
import SiteHeader from '../components/SiteHeader.astro';

const siteUrl = Astro.site?.toString() ?? 'https://shanekanterman.dev';
const pageUrl = new URL('/404/', siteUrl).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Page Not Found',
  description: 'Custom 404 page for Shane Kanterman portfolio site.',
  url: pageUrl,
};
---

<BaseLayout
  title="Page Not Found | Shane Kanterman"
  description="The page you requested could not be found. Browse infrastructure and web project case studies instead."
  structuredData={structuredData}
>
  <div class="page-shell relative z-10 pb-24">
    <SiteHeader backHref="/" backLabel="Home" />

    <main id="main-content" class="pt-6 max-[780px]:pt-1 min-h-[60vh]">
      <Sheet sheet={0} of={0} label="Sheet missing · 404" drawing="DWG SK-404" animate={false} labelledBy="not-found-title">
        <div class="hop-track" aria-hidden="true">
          <BrandRabbit height={64} mode="hop" class="hop-rabbit" />
        </div>
        <div class="max-w-[42rem]">
          <h1 class="case-title" id="not-found-title">Page not found.</h1>
          <p class="case-summary max-w-[34rem]">
            This sheet isn't in the set. You can return to the portfolio homepage, review project
            case studies, or connect on LinkedIn.
          </p>
          <div class="detail-actions max-[640px]:flex-col max-[640px]:items-stretch">
            <a class="dwg-btn dwg-btn-primary" href="/">Go home</a>
            <a class="dwg-btn" href="/projects">View projects</a>
            <a class="dwg-btn" href="https://www.linkedin.com/in/shane-kanterman-4511a2234" target="_blank" rel="noopener noreferrer">
              LinkedIn
            </a>
          </div>
        </div>
      </Sheet>
    </main>
  </div>
</BaseLayout>
