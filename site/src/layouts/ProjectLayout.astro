---
import GithubSlugger from 'github-slugger';
import BaseLayout from './BaseLayout.astro';
import DetailDrawing from '../components/DetailDrawing.astro';
import BrandRabbit from '../components/BrandRabbit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StackBadge from '../components/StackBadge.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, stack, status, date, links, heroImage, socialImage, role, scope, keyOutcome, kind, system } = project.data;
const isExperience = kind === 'experience';
// Helm leads with a reader-controlled workflow; its architecture follows the article.
const showHeaderDrawing = system && project.id !== 'helm';
const contentLabel = isExperience ? 'Experience Notes' : 'Case Study';
const returnHref = isExperience ? '/#about' : '/#projects';
const returnLabel = isExperience ? 'Back to experience' : 'Back to selected work';

// Siblings stay inside the entry's own `kind`, so an experience note never
// hands the reader off into the case-study sequence (and vice versa). With a
// single experience entry this correctly resolves to no pager at all.
const siblings = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((entry) => entry.data.kind === kind)
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = siblings.findIndex((entry) => entry.id === project.id);
const previousProject = currentIndex > 0 ? siblings[currentIndex - 1] : undefined;
const nextProject =
  currentIndex >= 0 && currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : undefined;

const formatted = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
}).format(date);

const statusLabel: Record<string, string> = {
  shipped: 'Shipped',
  'in-progress': 'In Progress',
  archived: 'Archived',
};

const statusClass: Record<string, string> = {
  shipped: 'project-status-shipped',
  'in-progress': 'project-status-progress',
  archived: 'project-status-archived',
};

const wordCount = project.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Same slugger rehype-slug uses, so TOC hrefs always match the ids it
// stamps on the rendered headings (incl. duplicate "-1" suffixing).
const headingMatches = project.body?.matchAll(/^##\s+(.+)$/gm) ?? [];
const tocItems: { text: string; slug: string }[] = [];
const slugger = new GithubSlugger();
for (const match of headingMatches) {
  const text = match[1].trim();
  tocItems.push({ text, slug: slugger.slug(text) });
}

const projectUrl = Astro.site ? new URL(`/projects/${project.id}/`, Astro.site).toString() : undefined;
const projectImagePath = socialImage ?? heroImage?.src ?? '/og/portfolio-rack-v2.png';
const projectImageUrl = projectImagePath
  ? Astro.site
    ? new URL(projectImagePath, Astro.site).toString()
    : projectImagePath
  : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  image: projectImageUrl,
  mainEntityOfPage: projectUrl,
  author: {
    '@type': 'Person',
    name: 'Shane Kanterman',
    url: Astro.site?.toString() ?? 'https://shanekanterman.dev',
  },
  publisher: {
    '@type': 'Person',
    name: 'Shane Kanterman',
  },
  keywords: stack.join(', '),
};
---

<BaseLayout
  title={`${title} | Shane Kanterman`}
  description={summary}
  image={projectImagePath}
  imageAlt={`${title} project preview`}
  type="article"
  structuredData={structuredData}
  chatEnabled={true}
>
  <div
    id="progress-bar"
    class="project-progress-bar fixed top-0 left-0 h-[2px] z-50 w-0 transition-none"
    aria-hidden="true"
  ></div>

  <div class="page-shell relative z-10 pb-24">
    <SiteHeader backHref={returnHref} backLabel={isExperience ? 'Experience' : 'Selected work'} />

    <main class="pt-6 max-[780px]:pt-3" id="main-content">
      <section class="sheet case-sheet" aria-labelledby="case-title">
        <div class="sheet-zones sheet-zones-top" aria-hidden="true">
          {['1', '2', '3', '4', '5', '6', '7', '8'].map((zone) => <span>{zone}</span>)}
        </div>
        <div class="sheet-zones sheet-zones-left" aria-hidden="true">
          {['A', 'B', 'C', 'D'].map((zone) => <span>{zone}</span>)}
        </div>
        <div class="case-meta">
          <span class="eyebrow">
            {contentLabel}
          </span>
          <span>{formatted}</span>
          <span class:list={['inline-flex items-center gap-1.5', statusClass[status]]}>
            <span class="project-status-dot w-1.5 h-1.5 rounded-full flex-shrink-0"></span>
            {statusLabel[status]}
          </span>
          <span>~{readingTime} min read</span>
        </div>
        <div class:list={['case-head', showHeaderDrawing && 'case-head-split']}>
          <div class="min-w-0">
            <h1 class="case-title" id="case-title">
              {title}
            </h1>
            <p class="case-summary">
              {summary}
            </p>
            <div class="stack-list case-stack">
              {stack.map((item) => (
                <StackBadge label={item} />
              ))}
            </div>
            {links && links.length > 0 && (
              <div class="detail-actions">
                {links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="dwg-btn">
                    {link.label}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </div>
          {showHeaderDrawing && system && (
            <div class="case-drawing dwg-box">
              <DetailDrawing system={system} label={`Detail drawing · ${title}`} id="case-detail" />
            </div>
          )}
        </div>
        <div class="project-detail-facts">
          <div>
            <p class="field-label">Role</p>
            <p class="project-proof-copy">{role}</p>
          </div>
          <div>
            <p class="field-label">Scope</p>
            <p class="project-proof-copy">{scope}</p>
          </div>
          <div>
            <p class="field-label">Outcome</p>
            <p class="project-proof-copy">{keyOutcome}</p>
          </div>
        </div>
      </section>
      <div class="case-body">
        <div class="case-prose">
          {tocItems.length > 0 && (
            <details class="mb-8 glass p-0 overflow-hidden w-full" data-toc-details>
              <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer text-[0.82rem] font-semibold text-text-muted select-none list-none">
                <span class="flex items-center gap-2">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="15" y2="12" />
                    <line x1="3" y1="18" x2="18" y2="18" />
                  </svg>
                  On this page
                </span>
                <svg class="toc-chevron w-4 h-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </summary>
              <nav class="px-5 pb-4 border-t border-line pt-3" aria-label="On this page">
                <ul class="grid gap-1 p-0 list-none">
                  {tocItems.map((item) => (
                    <li>
                      <a
                        href={`#${item.slug}`}
                        class="block py-1.5 text-[0.85rem] text-text-muted hover:text-text-base transition-colors duration-[180ms]"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )}

          <div class="prose">
            <slot />
          </div>
          {project.id === 'helm' && system && (
            <section class="mt-10 dwg-box" aria-label="Helm architecture reference">
              <DetailDrawing system={system} label="Architecture reference · Helm" id="case-detail" />
            </section>
          )}
        </div>

        {tocItems.length > 0 && (
          <aside class="toc-sidebar">
            <p class="field-label mb-3">
              On this page
            </p>
            <nav aria-label="Table of contents">
              <ul class="grid gap-0.5 p-0 list-none">
                {tocItems.map((item) => (
                  <li>
                    <a
                      href={`#${item.slug}`}
                      class="toc-link block py-1.5 text-[0.82rem] text-text-soft hover:text-text-base transition-colors duration-[180ms] leading-snug"
                      data-heading={item.slug}
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>

      <div class="case-footer">
        {(previousProject || nextProject) && (
          <nav class="case-pager" aria-label="More case studies">
            {previousProject ? (
              <a class="case-pager-link" href={`/projects/${previousProject.id}`} rel="prev">
                <span class="field-label">Previous</span>
                <span class="case-pager-title">{previousProject.data.title}</span>
              </a>
            ) : (
              <span class="case-pager-spacer" aria-hidden="true"></span>
            )}
            {nextProject && (
              <a class="case-pager-link case-pager-next" href={`/projects/${nextProject.id}`} rel="next">
                <span class="field-label">Next</span>
                <span class="case-pager-title">{nextProject.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <section class="glass case-lab-cta mb-8" aria-labelledby="case-contact-title">
          <BrandRabbit height={52} />
          <p class="case-lab-cta-copy">
            <strong id="case-contact-title">Talk infrastructure or products</strong>
            <span>
              Hiring for data center or infrastructure work? Get in touch with Shane.
              Explore KanterLabs for self-hosted products and developer tools.
            </span>
          </p>
          <a class="btn btn-primary" href="/#contact">
            Discuss infrastructure work
          </a>
          <a class="btn btn-secondary" href="/kanterlabs">Explore KanterLabs products</a>
        </section>

        <a
          href={returnHref}
          class="inline-flex items-center gap-2 min-h-11 text-text-muted hover:text-text-base transition-colors duration-[180ms] font-medium"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M19 12H5M12 5l-7 7 7 7" />
          </svg>
          {returnLabel}
        </a>
      </div>
    </main>
  </div>

  <script>
    const progressBar = document.getElementById('progress-bar');
    let progressFrame = 0;

    const updateProgress = () => {
      if (!progressBar) return;
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(pct, 100)}%`;
      progressFrame = 0;
    };

    const requestProgressUpdate = () => {
      if (progressFrame !== 0) return;
      progressFrame = window.requestAnimationFrame(updateProgress);
    };

    updateProgress();
    window.addEventListener('scroll', requestProgressUpdate, { passive: true });

    const tocLinks = Array.from(document.querySelectorAll('a.toc-link'));

    if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
      const headingEls = tocLinks
        .map((link) => {
          const id = link.getAttribute('data-heading');
          return id ? document.getElementById(id) : null;
        })
        .filter((el) => el instanceof HTMLElement);

      const setActive = (id) => {
        tocLinks.forEach((link) => {
          const isActive = link.getAttribute('data-heading') === id;
          link.classList.toggle('toc-link-active', isActive);
          if (isActive) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: '0px 0px -70% 0px', threshold: 0 },
      );

      headingEls.forEach((el) => observer.observe(el));
      if (headingEls[0]) setActive(headingEls[0].id);
    }

    const tocDetails = document.querySelector('[data-toc-details]');
    const tocChevron = document.querySelector('.toc-chevron');

    if (tocDetails instanceof HTMLDetailsElement && tocChevron instanceof SVGElement) {
      tocDetails.addEventListener('toggle', () => {
        tocChevron.style.transform = tocDetails.open ? 'rotate(180deg)' : '';
      });

      tocDetails.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          tocDetails.open = false;
        });
      });
    }
  </script>
</BaseLayout>
