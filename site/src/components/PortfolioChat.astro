<div class="portfolio-chat" data-portfolio-chat>
  <button
    class="portfolio-chat-launcher"
    type="button"
    data-chat-launcher
    aria-expanded="false"
    aria-controls="portfolio-chat-panel"
  >
    <span class="portfolio-chat-launcher-mark" aria-hidden="true">?</span>
    <span>Ask about Shane</span>
  </button>

  <section
    class="portfolio-chat-panel"
    id="portfolio-chat-panel"
    data-chat-panel
    role="dialog"
    aria-modal="false"
    aria-labelledby="portfolio-chat-title"
    aria-hidden="true"
    hidden
  >
    <div class="portfolio-chat-header">
      <div>
        <p class="portfolio-chat-kicker">Portfolio assistant</p>
        <h2 id="portfolio-chat-title">Ask about Shane</h2>
      </div>
      <button class="portfolio-chat-close" type="button" data-chat-close aria-label="Close portfolio assistant">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <div class="portfolio-chat-body">
      <div class="portfolio-chat-transcript" data-chat-transcript role="log" aria-live="polite" aria-relevant="additions text">
        <article class="portfolio-chat-message portfolio-chat-message-assistant">
          <p>
            I'm Shane's portfolio assistant—not Shane himself. Ask me about his projects,
            infrastructure experience, or how to get in touch.
          </p>
        </article>
      </div>

      <div class="portfolio-chat-starters" aria-label="Starter questions">
        <p class="portfolio-chat-label">Try a question</p>
        <div class="portfolio-chat-starter-list">
          <button type="button" class="portfolio-chat-starter" data-chat-starter>
            What kinds of systems does Shane build?
          </button>
          <button type="button" class="portfolio-chat-starter" data-chat-starter>
            Tell me about Shane's platform projects.
          </button>
          <button type="button" class="portfolio-chat-starter" data-chat-starter>
            What is Shane's data center experience?
          </button>
          <button type="button" class="portfolio-chat-starter" data-chat-starter>
            How can I contact Shane?
          </button>
        </div>
      </div>

      <div class="portfolio-chat-sources" data-chat-sources aria-label="Sources" hidden></div>
      <p class="portfolio-chat-status" data-chat-status role="status" aria-live="polite" aria-atomic="true">
        Ready when you are.
      </p>

      <form class="portfolio-chat-form" data-chat-form novalidate>
        <label class="portfolio-chat-visually-hidden" for="portfolio-chat-input">Your question</label>
        <textarea
          id="portfolio-chat-input"
          class="portfolio-chat-input"
          data-chat-input
          name="message"
          rows="2"
          maxlength="800"
          autocomplete="off"
          placeholder="Ask a question…"
          required
        ></textarea>
        <div class="portfolio-chat-form-row">
          <span class="portfolio-chat-limit">800 character limit</span>
          <button class="portfolio-chat-send" type="submit" data-chat-send>
            <span>Send</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M22 2L11 13" />
              <path d="M22 2l-7 20-4-9-9-4 20-7Z" />
            </svg>
          </button>
        </div>
        <button class="portfolio-chat-retry" type="button" data-chat-retry hidden>Try sending again</button>
      </form>
    </div>
  </section>
</div>

<script>
  type ChatRole = 'user' | 'assistant';
  type ChatMessage = { role: ChatRole; content: string };
  type Source = { title: string; href: string };

  const root = document.querySelector<HTMLElement>('[data-portfolio-chat]');

  if (root) {
    const launcher = root.querySelector<HTMLButtonElement>('[data-chat-launcher]');
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-chat-close]');
    const transcript = root.querySelector<HTMLElement>('[data-chat-transcript]');
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]');
    const input = root.querySelector<HTMLTextAreaElement>('[data-chat-input]');
    const sendButton = root.querySelector<HTMLButtonElement>('[data-chat-send]');
    const status = root.querySelector<HTMLElement>('[data-chat-status]');
    const sources = root.querySelector<HTMLElement>('[data-chat-sources]');
    const retryButton = root.querySelector<HTMLButtonElement>('[data-chat-retry]');
    const starterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-chat-starter]'));

    if (
      launcher &&
      panel &&
      closeButton &&
      transcript &&
      form &&
      input &&
      sendButton &&
      status &&
      sources &&
      retryButton
    ) {
      const maxMessageLength = 800;
      const safetyIdKey = 'portfolio-chat-safety-id';
      const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
      let messageHistory: ChatMessage[] = [];
      let activeController: AbortController | null = null;
      let requestSequence = 0;
      let isBusy = false;
      let lastFailedMessage = '';

      const setStatus = (message: string) => {
        status.textContent = message;
      };

      const createUuid = () => {
        if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
          return crypto.randomUUID();
        }

        if (typeof crypto !== 'undefined' && typeof crypto.getRandomValues === 'function') {
          const bytes = new Uint8Array(16);
          crypto.getRandomValues(bytes);
          bytes[6] = (bytes[6] & 0x0f) | 0x40;
          bytes[8] = (bytes[8] & 0x3f) | 0x80;
          const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
          return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
        }

        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (character) => {
          const random = Math.floor(Math.random() * 16);
          const value = character === 'x' ? random : (random & 0x3) | 0x8;
          return value.toString(16);
        });
      };

      const getVisitorId = () => {
        try {
          const existingId = window.localStorage.getItem(safetyIdKey);
          if (existingId && uuidPattern.test(existingId)) return existingId;

          const newId = createUuid();
          window.localStorage.setItem(safetyIdKey, newId);
          return newId;
        } catch {
          // Private browsing and blocked storage should not prevent a chat request.
          return createUuid();
        }
      };

      const appendMessage = (role: ChatRole, content = '') => {
        const article = document.createElement('article');
        article.className = `portfolio-chat-message portfolio-chat-message-${role}`;
        const paragraph = document.createElement('p');
        paragraph.textContent = content;
        article.append(paragraph);
        transcript.append(article);
        transcript.scrollTop = transcript.scrollHeight;
        return paragraph;
      };

      const renderSources = (items: unknown) => {
        sources.textContent = '';
        const safeSources: Source[] = [];

        if (Array.isArray(items)) {
          items.forEach((item) => {
            if (!item || typeof item !== 'object') return;
            const candidate = item as { title?: unknown; href?: unknown };
            if (typeof candidate.href !== 'string' || typeof candidate.title !== 'string') return;
            const href = candidate.href.trim();
            const title = candidate.title.trim();
            if (!href.startsWith('/') || href.startsWith('//') || !title) return;
            safeSources.push({ href, title });
          });
        }

        if (safeSources.length === 0) {
          sources.hidden = true;
          return;
        }

        const label = document.createElement('p');
        label.className = 'portfolio-chat-label';
        label.textContent = 'Related pages';
        const list = document.createElement('ul');
        list.className = 'portfolio-chat-source-list';

        safeSources.forEach(({ title, href }) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = href;
          link.textContent = title;
          item.append(link);
          list.append(item);
        });

        sources.append(label, list);
        sources.hidden = false;
      };

      const setBusy = (busy: boolean) => {
        isBusy = busy;
        input.disabled = busy;
        sendButton.disabled = busy;
        starterButtons.forEach((button) => {
          button.disabled = busy;
        });
        sendButton.setAttribute('aria-busy', busy ? 'true' : 'false');
        if (!busy) input.maxLength = maxMessageLength;
      };

      const setPanelOpen = (open: boolean) => {
        panel.hidden = !open;
        panel.setAttribute('aria-hidden', open ? 'false' : 'true');
        launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
        root.classList.toggle('portfolio-chat-open', open);
        if (open) {
          window.requestAnimationFrame(() => input.focus());
        }
      };

      const closePanel = () => {
        if (activeController) {
          activeController.abort();
          activeController = null;
        }
        requestSequence += 1;
        setBusy(false);
        setStatus('Chat closed.');
        setPanelOpen(false);
        launcher.focus();
      };

      const isAbortError = (error: unknown) => {
        return Boolean(error && typeof error === 'object' && 'name' in error && error.name === 'AbortError');
      };

      const handleEvent = (
        block: string,
        onDelta: (delta: string) => void,
        onSources: (items: unknown) => void,
      ) => {
        const lines = block.split(/\r?\n/);
        let eventName = 'message';
        const dataLines: string[] = [];

        lines.forEach((line) => {
          if (line.startsWith(':')) return;
          if (line.startsWith('event:')) {
            eventName = line.slice(6).trim();
          } else if (line.startsWith('data:')) {
            dataLines.push(line.slice(5).trimStart());
          }
        });

        if (dataLines.length === 0 && eventName !== 'done') return false;

        let payload: unknown = {};
        if (dataLines.length > 0) {
          try {
            payload = JSON.parse(dataLines.join('\n')) as unknown;
          } catch {
            if (eventName === 'error') throw new Error('The assistant returned an unreadable error.');
            return false;
          }
        }

        if (eventName === 'done') return true;

        if (eventName === 'delta') {
          if (payload && typeof payload === 'object' && 'delta' in payload && typeof payload.delta === 'string') {
            onDelta(payload.delta);
          }
          return false;
        }

        if (eventName === 'sources') {
          if (payload && typeof payload === 'object' && 'sources' in payload) {
            onSources(payload.sources);
          }
          return false;
        }

        if (eventName === 'error') {
          const message =
            payload && typeof payload === 'object' && 'message' in payload && typeof payload.message === 'string'
              ? payload.message
              : 'The assistant is temporarily unavailable.';
          throw new Error(message);
        }

        // A few SSE clients omit `event: message` for a data-only delta.
        if (eventName === 'message' && payload && typeof payload === 'object') {
          if ('delta' in payload && typeof payload.delta === 'string') onDelta(payload.delta);
          if ('sources' in payload) onSources(payload.sources);
          if ('done' in payload && payload.done === true) return true;
        }

        return false;
      };

      const readSse = async (
        response: Response,
        onDelta: (delta: string) => void,
        onSources: (items: unknown) => void,
      ) => {
        if (!response.body) throw new Error('The assistant did not return a stream.');
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let complete = false;

        const processBuffer = () => {
          const blocks = buffer.split(/\r?\n\r?\n/);
          buffer = blocks.pop() ?? '';
          for (const block of blocks) {
            if (handleEvent(block, onDelta, onSources)) {
              complete = true;
              break;
            }
          }
        };

        while (!complete) {
          const { value, done } = await reader.read();
          if (done) {
            buffer += decoder.decode();
            break;
          }
          buffer += decoder.decode(value, { stream: true });
          processBuffer();
        }

        if (!complete && buffer.trim()) handleEvent(buffer, onDelta, onSources);
      };

      const submitMessage = async (messageOverride?: string) => {
        if (isBusy) return;
        const rawMessage = messageOverride ?? input.value;
        const message = rawMessage.trim();

        if (!message) {
          setStatus('Enter a question first.');
          input.focus();
          return;
        }

        if (message.length > maxMessageLength) {
          input.value = message.slice(0, maxMessageLength);
          setStatus('Please keep your question under 800 characters.');
          input.focus();
          return;
        }

        input.value = '';
        retryButton.hidden = true;
        lastFailedMessage = '';
        renderSources([]);
        appendMessage('user', message);
        const assistantParagraph = appendMessage('assistant');
        const controller = new AbortController();
        const sequence = ++requestSequence;
        activeController = controller;
        setBusy(true);
        setStatus('Thinking…');

        try {
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: {
              Accept: 'text/event-stream',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              message,
              history: messageHistory.slice(-6),
              pagePath: window.location.pathname,
              visitorId: getVisitorId(),
            }),
            signal: controller.signal,
          });

          if (!response.ok) throw new Error('The assistant is temporarily unavailable.');

          let assistantText = '';
          await readSse(
            response,
            (delta) => {
              assistantText += delta;
              assistantParagraph.textContent = assistantText;
            },
            (items) => renderSources(items),
          );

          if (!assistantText) {
            assistantText = 'I could not find an answer for that yet. Please try another question.';
            assistantParagraph.textContent = assistantText;
          }

          if (sequence === requestSequence) {
            messageHistory = [...messageHistory, { role: 'user', content: message }, { role: 'assistant', content: assistantText }].slice(-6);
            setStatus('Response complete.');
          }
        } catch (error) {
          if (isAbortError(error) || sequence !== requestSequence) return;
          assistantParagraph.textContent = 'I’m unavailable right now. Please try sending your question again.';
          lastFailedMessage = message;
          input.value = message;
          retryButton.hidden = false;
          const errorMessage = error instanceof Error && error.message ? error.message : 'The assistant is unavailable.';
          setStatus(`${errorMessage} Try again when you’re ready.`);
        } finally {
          if (sequence === requestSequence) {
            activeController = null;
            setBusy(false);
          }
        }
      };

      launcher.addEventListener('click', () => {
        setPanelOpen(true);
      });
      closeButton.addEventListener('click', closePanel);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.hidden) {
          event.preventDefault();
          closePanel();
        }
      });
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        void submitMessage();
      });
      input.addEventListener('input', () => {
        if (input.value.length > maxMessageLength) {
          input.value = input.value.slice(0, maxMessageLength);
          setStatus('Please keep your question under 800 characters.');
        }
      });
      retryButton.addEventListener('click', () => {
        if (!lastFailedMessage) return;
        void submitMessage(lastFailedMessage);
      });
      starterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (isBusy) return;
          const question = button.textContent?.trim() ?? '';
          input.value = question;
          void submitMessage(question);
        });
      });
    }
  }
</script>

<style is:global>
  .portfolio-chat {
    --chat-surface: var(--panel-strong, #141816);
    --chat-surface-soft: var(--panel-soft, #0f1210);
    --chat-text: var(--color-text-base, #e6e8e7);
    --chat-muted: var(--color-text-muted, #9aa3a0);
    --chat-soft: var(--color-text-soft, #78837d);
    --chat-line: var(--line, rgba(255, 255, 255, 0.08));
    --chat-line-strong: var(--line-strong, rgba(255, 255, 255, 0.16));
    --chat-accent: var(--accent-color, #8fb8a3);
    --chat-accent-ink: var(--accent-ink, #0c0e0d);
    color: var(--chat-text);
    font-family: var(--font-family-sans);
  }

  .portfolio-chat-launcher {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 55;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.65rem 0.95rem;
    border: 1px solid var(--chat-line-strong);
    border-radius: 999px;
    color: var(--chat-text);
    background: color-mix(in srgb, var(--chat-surface) 92%, var(--chat-accent) 8%);
    box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--color-bg, #0c0e0d) 38%, transparent);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .portfolio-chat-launcher:hover {
    transform: translateY(-2px);
    border-color: var(--chat-accent);
  }

  .portfolio-chat-launcher-mark {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.72rem;
    line-height: 1;
  }

  .portfolio-chat-panel {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(4.75rem, calc(env(safe-area-inset-bottom) + 4.25rem));
    z-index: 55;
    display: flex;
    flex-direction: column;
    width: min(calc(100vw - 2rem), 26rem);
    max-height: min(80dvh, 42rem);
    overflow: hidden;
    border: 1px solid var(--chat-line-strong);
    border-radius: 1.15rem;
    background: var(--chat-surface);
    box-shadow: 0 1.25rem 4rem color-mix(in srgb, var(--color-bg, #0c0e0d) 48%, transparent);
  }

  .portfolio-chat-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.9rem;
    border-bottom: 1px solid var(--chat-line);
  }

  .portfolio-chat-kicker,
  .portfolio-chat-label {
    margin: 0;
    color: var(--chat-soft);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .portfolio-chat-header h2 {
    margin: 0.28rem 0 0;
    color: var(--chat-text);
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .portfolio-chat-close {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: -0.35rem -0.35rem 0 0;
    border: 1px solid transparent;
    border-radius: 0.65rem;
    color: var(--chat-muted);
    background: transparent;
    cursor: pointer;
  }

  .portfolio-chat-close:hover {
    border-color: var(--chat-line-strong);
    color: var(--chat-text);
  }

  .portfolio-chat-body {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0.9rem;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .portfolio-chat-transcript {
    display: grid;
    gap: 0.65rem;
    min-height: 3.3rem;
    max-height: 15rem;
    overflow: auto;
    padding-right: 0.15rem;
    overscroll-behavior: contain;
  }

  .portfolio-chat-message {
    width: fit-content;
    max-width: 92%;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--chat-line);
    border-radius: 0.8rem;
    color: var(--chat-text);
    background: var(--chat-surface-soft);
    font-size: 0.84rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .portfolio-chat-message p {
    margin: 0;
  }

  .portfolio-chat-message-user {
    justify-self: end;
    border-color: color-mix(in srgb, var(--chat-accent) 38%, var(--chat-line));
    background: color-mix(in srgb, var(--chat-accent) 13%, var(--chat-surface));
  }

  .portfolio-chat-message-assistant {
    justify-self: start;
  }

  .portfolio-chat-starters {
    display: grid;
    gap: 0.45rem;
  }

  .portfolio-chat-starter-list {
    display: grid;
    gap: 0.4rem;
  }

  .portfolio-chat-starter {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--chat-line);
    border-radius: 0.6rem;
    color: var(--chat-muted);
    background: transparent;
    font-size: 0.76rem;
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  .portfolio-chat-starter:hover {
    border-color: var(--chat-accent);
    color: var(--chat-text);
  }

  .portfolio-chat-starter:disabled,
  .portfolio-chat-send:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .portfolio-chat-sources {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--chat-line);
  }

  .portfolio-chat-source-list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .portfolio-chat-source-list a {
    color: var(--chat-accent);
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .portfolio-chat-status {
    min-height: 1.1rem;
    margin: 0;
    color: var(--chat-soft);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .portfolio-chat-form {
    display: grid;
    gap: 0.55rem;
    margin-top: auto;
  }

  .portfolio-chat-input {
    width: 100%;
    min-height: 3rem;
    max-height: 8rem;
    resize: vertical;
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--chat-line-strong);
    border-radius: 0.7rem;
    color: var(--chat-text);
    background: var(--chat-surface-soft);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .portfolio-chat-input::placeholder {
    color: var(--chat-soft);
  }

  .portfolio-chat-input:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .portfolio-chat-form-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .portfolio-chat-limit {
    color: var(--chat-soft);
    font-size: 0.68rem;
  }

  .portfolio-chat-send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--chat-accent);
    border-radius: 0.65rem;
    color: var(--chat-accent-ink);
    background: var(--chat-accent);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .portfolio-chat-send:hover:not(:disabled) {
    background: var(--color-accent-strong, var(--chat-accent));
  }

  .portfolio-chat-retry {
    justify-self: start;
    padding: 0.15rem 0;
    border: 0;
    color: var(--chat-accent);
    background: transparent;
    font-size: 0.75rem;
