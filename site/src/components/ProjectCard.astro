---
import type { CollectionEntry } from 'astro:content';
import ProjectStatus from './ProjectStatus.astro';
import SystemDiagram from './SystemDiagram.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="project-card project-entry">
  <div class="project-card-header">
    <p class="eyebrow">Case study</p>
    <ProjectStatus status={project.data.status} />
  </div>

  <h3 class="project-title">
    <a href={`/projects/${project.id}`} class="project-title-link">
      {project.data.title}
    </a>
  </h3>
  <p class="project-summary">{project.data.summary}</p>
  <SystemDiagram system={project.data.system} variant="strip" />
  <p class="project-stack">{project.data.stack.join(' · ')}</p>
  <a href={`/projects/${project.id}`} class="text-link">
    See project breakdown
    <span aria-hidden="true">↗</span>
  </a>
</article>
