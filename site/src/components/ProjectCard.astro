---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;

const statusLabel: Record<(typeof project.data.status), string> = {
  shipped: 'Shipped',
  'in-progress': 'In Progress',
  archived: 'Archived',
};
---

<article class:list={['project-row', featured && 'project-row-featured']}>
  <div class="project-row-header">
    <p class="eyebrow">{featured ? 'Featured case study' : 'Case study'}</p>
    <span class:list={['project-status', `project-status-${project.data.status}`]}>
      <span class="project-status-dot" aria-hidden="true"></span>
      {statusLabel[project.data.status]}
    </span>
  </div>

  <h3 class="project-row-title">
    {project.data.title}
  </h3>
  <p class="project-row-summary">{project.data.summary}</p>
  {featured && project.data.keyOutcome && (
    <p class="project-row-outcome">
      <span class="project-row-outcome-label">Outcome</span>
      {project.data.keyOutcome}
    </p>
  )}
  <p class="project-row-stack">{project.data.stack.join(' · ')}</p>
  <a href={`/projects/${project.id}`} class="text-link">
    {featured ? 'Read deployment case study' : 'See project breakdown'}
    <span aria-hidden="true">↗</span>
  </a>
</article>
