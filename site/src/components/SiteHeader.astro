---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  home?: boolean;
  navItems?: NavItem[];
  backHref?: string;
  backLabel?: string;
}

import ThemeToggle from './ThemeToggle.astro';

const {
  home = false,
  navItems = [],
  backHref = '/#projects',
  backLabel = 'All projects',
} = Astro.props;
---

<header class="site-header sticky top-0 z-20" data-site-header>
  <div
    class="header-inner flex items-center justify-between gap-4 py-5 border-b border-transparent transition-[background-color,border-color,padding] duration-[180ms] ease-out"
  >
    <a class="inline-flex items-center gap-2.5 min-w-0" href={home ? '#top' : '/'} aria-label="Shane Kanterman home">
      <strong class="text-[0.95rem] leading-tight text-text-base font-semibold">Shane Kanterman</strong>
      <span class="text-[0.82rem] leading-tight text-text-soft max-[780px]:hidden">
        Infrastructure and Web Projects
      </span>
    </a>

    {home ? (
      <>
        <nav class="flex items-center gap-6 max-[780px]:hidden" aria-label="Primary">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link py-1 text-[0.9rem] text-text-muted hover:text-text-base transition-colors duration-[180ms]"
              data-nav-link={item.href.replace('#', '')}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <button
          class="mobile-toggle hidden max-[780px]:inline-grid place-items-center w-11 h-11 border border-line-strong bg-transparent rounded-full p-0 cursor-pointer"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="block w-[1.1rem] h-[2px] my-[3px] mx-auto bg-[#e6e8e7] rounded-full transition-transform duration-[180ms]"></span>
          <span class="block w-[1.1rem] h-[2px] my-[3px] mx-auto bg-[#e6e8e7] rounded-full transition-[transform,opacity] duration-[180ms]"></span>
          <span class="block w-[1.1rem] h-[2px] my-[3px] mx-auto bg-[#e6e8e7] rounded-full transition-transform duration-[180ms]"></span>
          <span class="sr-only">Toggle navigation</span>
        </button>
        <ThemeToggle />
      </>
    ) : (
      <>
        <a
          href={backHref}
          class="inline-flex items-center gap-2 min-h-11 text-text-muted hover:text-text-base transition-colors duration-[180ms] text-sm font-medium"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M19 12H5M12 5l-7 7 7 7" />
          </svg>
          {backLabel}
        </a>
        <ThemeToggle />
      </>
    )}
  </div>

  {home && (
    <nav
      class="mobile-nav-panel glass mt-2 p-1.5 rounded-[var(--radius-md)]"
      id="mobile-nav"
      aria-label="Mobile navigation"
      data-mobile-nav
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link flex items-center min-h-11 px-4 py-2 rounded-xl text-text-muted hover:text-text-base hover:bg-[rgba(255,255,255,0.04)] transition-colors duration-[180ms] text-[0.95rem]"
          data-nav-link={item.href.replace('#', '')}
        >
          {item.label}
        </a>
      ))}
    </nav>
  )}
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    let scrollFrame = 0;

    const syncHeader = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
      scrollFrame = 0;
    };

    const requestHeaderSync = () => {
      if (scrollFrame !== 0) return;
      scrollFrame = window.requestAnimationFrame(syncHeader);
    };

    syncHeader();
    window.addEventListener('scroll', requestHeaderSync, { passive: true });

    const mobileToggle = header.querySelector<HTMLButtonElement>('.mobile-toggle');
    const mobileNav = header.querySelector<HTMLElement>('[data-mobile-nav]');
    // Complement of Tailwind's max-[780px] (= width < 780px)
    const desktopBreakpoint = window.matchMedia('(width >= 780px)');

    if (mobileToggle && mobileNav) {
      const iconBars = mobileToggle.querySelectorAll<HTMLElement>('span:not(.sr-only)');

      const renderMenuState = (open: boolean) => {
        mobileToggle.setAttribute('aria-expanded', String(open));
        mobileNav.classList.toggle('is-open', open);

        if (open) {
          iconBars[0]?.style.setProperty('transform', 'translateY(8px) rotate(45deg)');
          iconBars[1]?.style.setProperty('opacity', '0');
          iconBars[2]?.style.setProperty('transform', 'translateY(-8px) rotate(-45deg)');
        } else {
          iconBars[0]?.style.removeProperty('transform');
          iconBars[1]?.style.removeProperty('opacity');
          iconBars[2]?.style.removeProperty('transform');
        }
      };

      const closeMenu = (restoreFocus = true) => {
        renderMenuState(false);
        if (restoreFocus) mobileToggle.focus();
      };

      renderMenuState(false);

      mobileToggle.addEventListener('click', () => {
        const shouldOpen = mobileToggle.getAttribute('aria-expanded') !== 'true';
        renderMenuState(shouldOpen);

        if (shouldOpen) {
          mobileNav.querySelector('a')?.focus();
        }
      });

      mobileNav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeMenu(false);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileToggle.getAttribute('aria-expanded') === 'true') {
          closeMenu();
        }
      });

      document.addEventListener('click', (event) => {
        if (
          mobileToggle.getAttribute('aria-expanded') === 'true' &&
          event.target instanceof Node &&
          !header.contains(event.target)
        ) {
          closeMenu(false);
        }
      });

      desktopBreakpoint.addEventListener('change', (event) => {
        if (event.matches) {
          closeMenu(false);
        }
      });
    }
  }
</script>
