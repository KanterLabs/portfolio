---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  class?: string;
}

const { eyebrow, title, body, class: className = '' } = Astro.props;
---

<div class={`max-w-[48rem] mb-8 max-[780px]:mb-6 ${className}`}>
  <p class="eyebrow">{eyebrow}</p>
  <h2
    class="text-[clamp(1.8rem,4.1vw,2.5rem)] leading-[1.12] tracking-[-0.025em] mb-4 font-bold text-text-base max-[780px]:text-[clamp(1.7rem,8vw,2.2rem)]"
  >
    {title}
  </h2>
  <p class="text-text-muted leading-[1.75] text-[1rem]">{body}</p>
</div>
