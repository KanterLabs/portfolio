---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  class?: string;
}

const { eyebrow, title, body, class: className = '' } = Astro.props;
---

<div class={`max-w-[48rem] mb-10 max-[780px]:mb-7 ${className}`} data-section-intro>
  <p class="eyebrow">{eyebrow}</p>
  <h2
    class="text-[length:var(--step-section)] leading-[1.12] tracking-[-0.025em] mb-4 font-bold text-text-base"
  >
    {title}
  </h2>
  <p class="text-text-muted leading-[1.75] text-[1rem]">{body}</p>
</div>
