---
import RepoMedia from './RepoMedia.astro';
import { repoUrl, type LabRepo } from '../lib/kanterlabs';

/**
 * One photo plate: a flagship repository's real screenshot, video, or quick
 * start, framed like a plate in a drawing set and keyed to its rack callout.
 */
interface Props {
  repo: LabRepo;
  plate: number;
  callout: string;
}

const { repo, plate, callout } = Astro.props;
const { media } = repo;
const href = repoUrl(repo);
---

<article class="plate dwg-box" data-lab-repo={repo.slug}>
  <p class="plate-head dwg-label">
    <span>Plate {plate} · {repo.name}</span>
    <span class="plate-callout" aria-hidden="true">{callout}</span>
  </p>
  {media && <RepoMedia media={media} name={repo.name} />}

  <div class="plate-body">
    <h3 class="detail-title">
      <a href={href} target="_blank" rel="noopener noreferrer">{repo.name}</a>
    </h3>
    <p class="detail-summary">{repo.summary}</p>
    <p class="dwg-label plate-meta">{repo.status} · {repo.stack.join(' · ')}</p>
    <div class="plate-links">
      <a class="text-link" href={href} target="_blank" rel="noopener noreferrer">
        KanterLabs/{repo.slug}
        <span aria-hidden="true">↗</span>
      </a>
      {repo.caseStudy && (
        <a class="text-link" href={repo.caseStudy.href}>
          {repo.caseStudy.label}
        </a>
      )}
      {repo.site && (
        <a
          class="text-link"
          href={repo.site.href}
          {...(repo.site.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {repo.site.label}
        </a>
      )}
    </div>
  </div>
</article>
