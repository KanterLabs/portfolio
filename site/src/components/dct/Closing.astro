---
import { Image } from 'astro:assets';
import DiscordGlyph from './DiscordGlyph.astro';
import { discordUrl, playtestUrl } from './links';
import keyArt from '../../assets/datacentertycoon/key-art.jpg';
---

<section class="closing dct-panel" aria-labelledby="closing-title">
  <div class="dct-panel-header">
    <p class="panel-title eyebrow-title">Your first rack is waiting</p>
    <span class="status-pill"><span class="dot dot-success" aria-hidden="true"></span>Playtesting now</span>
  </div>
  <div class="dct-panel-body closing-body">
    <div class="closing-copy">
      <h2 id="closing-title">Five nines<br /><span>or bust.</span></h2>
      <p>Join the Discord to follow development and hear first when the next playtest opens. Playtest builds go out in small batches.</p>
      <div class="closing-actions">
        <a class="dct-button primary" href={discordUrl}>
          <DiscordGlyph />
          Join the Discord
        </a>
        <a class="dct-button secondary" href={playtestUrl}>Request playtest access</a>
      </div>
      <p class="closing-note">Playtest access opens a pre-filled email to Shane.</p>
    </div>
    <div class="closing-art">
      <Image
        src={keyArt}
        alt="Key art: a dark data hall with rows of server racks, large cooling units, blue and yellow cable runs, and technicians in hard hats at work."
        widths={[640, 1280]}
        sizes="(max-width: 1099px) 100vw, 560px"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  /* A panel with the key art framed inside it. */
  .closing { width: min(calc(100% - 3rem), 1180px); margin: 5rem auto; }
  .closing-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; align-items: center; }
  .closing-copy { text-align: left; }
  .closing h2 span { color: var(--dct-accent); }
  .closing-copy > p:not(.closing-note) { margin: 1rem 0 1.5rem; color: var(--dct-muted); }
  .closing-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .closing-actions .dct-button { min-height: 48px; }
  .closing .closing-note { margin: 1rem 0 0; color: var(--dct-muted); font-size: .8125rem; }
  .closing-art { order: -1; overflow: hidden; background: var(--dct-header); border: 1px solid var(--dct-border); border-radius: var(--dct-radius-field); }
  .closing-art img { display: block; width: 100%; height: auto; aspect-ratio: 21 / 9; object-fit: cover; object-position: 60% 50%; }

  @media (width >= 1100px) {
    .closing-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; }
    .closing-art { order: 0; }
    .closing-art img { aspect-ratio: 16 / 10; object-position: 62% 50%; }
  }
  @media (width < 780px) {
    .closing { width: min(calc(100% - 2rem), 1180px); margin: 4rem auto; }
    .closing-actions { flex-direction: column; }
    .closing-actions .dct-button { width: 100%; }
  }
</style>
