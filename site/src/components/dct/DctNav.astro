---
import DiscordGlyph from './DiscordGlyph.astro';
import { discordUrl } from './links';
---

<header class="dct-nav" aria-label="Data Center Tycoon navigation">
  <a class="brand" href="/datacentertycoon" aria-label="Data Center Tycoon home">
    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="brand-text">Data Center Tycoon</span>
  </a>
  <nav aria-label="Page navigation">
    <a href="#gameplay">Gameplay</a>
    <a href="#systems">Systems</a>
    <a class="nav-discord dct-button primary" href={discordUrl}>
      <DiscordGlyph />
      Discord
    </a>
    <a class="nav-portfolio dct-button quiet" href="/"><span class="nav-label">Shane's portfolio</span><span class="nav-short" aria-hidden="true">Portfolio</span> <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<style>
  .dct-nav { width: min(calc(100% - 3rem), 1180px); height: 72px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--dct-border); background: transparent; }
  .brand { display: inline-flex; align-items: center; justify-content: center; gap: .75rem; min-width: 44px; min-height: 44px; font-size: 1rem; font-weight: 600; }
  .brand-mark { width: 28px; height: 28px; padding: 5px 6px; display: grid; align-content: center; gap: 3px; background: var(--dct-panel); border: 1px solid var(--dct-border); border-radius: var(--dct-radius-control); }
  .brand-mark i { position: relative; display: block; height: 3px; background: var(--dct-normal-border); }
  .brand-mark i:first-child::after { content: ''; position: absolute; top: 0; right: 0; width: 3px; height: 3px; background: var(--dct-success); }
  .dct-nav nav { display: flex; align-items: center; gap: 1.5rem; }
  .dct-nav nav > a:not(.dct-button) { display: inline-flex; align-items: center; min-height: 44px; color: var(--dct-muted); font-size: .875rem; font-weight: 600; }
  .dct-nav nav > a:not(.dct-button):hover { color: var(--dct-text); }
  .dct-nav .nav-discord, .dct-nav .nav-portfolio { min-height: 44px; padding: 0 14px; }
  .dct-nav .nav-portfolio { gap: 6px; white-space: nowrap; }
  .nav-short { display: none; }
  @media (width < 780px) {
    .dct-nav { width: min(calc(100% - 2rem), 1180px); }
    .dct-nav nav { gap: .5rem; }
    .dct-nav nav > a:not(.dct-button) { display: none; }
    .nav-short { display: inline; }
    .nav-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (width < 640px) {
    .brand-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
