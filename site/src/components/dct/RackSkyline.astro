---
// Decorative skyline of server racks for the Data Center Tycoon hero.
// Fully deterministic: unit counts are fixed and LEDs are placed by modular
// formulas, so every build renders the same vector art (no randomness, no JS).
const racks = [14, 11, 17, 9, 13, 15, 10, 18, 8, 14, 12, 16, 9, 15, 11, 13];
---

<div class="rack-skyline" aria-hidden="true">
  <div class="skyline-racks">
    {racks.map((units, r) => {
      const height = 10 + units * 12;
      return (
        <svg
          class="rack"
          viewBox={`0 0 60 ${height}`}
          style={`aspect-ratio: 60 / ${height}`}
          focusable="false"
          data-units={units}
        >
          <rect class="r-body" x="1" y="1" width="58" height={height - 2} />
          <rect class="r-cap" x="0" y="0" width="60" height="3" />
          {Array.from({ length: units }, (_, u) => (
            <>
              <rect class="r-unit" x="6" y={7 + u * 12} width="36" height="9" rx="1" />
              <rect class={(r + u * 2) % 9 === 0 ? 'led led-blink' : 'led'} x="46" y={10 + u * 12} width="3" height="3" />
              {(r * 5 + u * 3) % 7 === 0 && <rect class="led led-white" x="51" y={10 + u * 12} width="3" height="3" />}
            </>
          ))}
        </svg>
      );
    })}
  </div>
  <div class="skyline-floor"></div>
</div>

<style>
  .rack-skyline { margin-top: 2.5rem; }
  .skyline-racks { display: flex; align-items: flex-end; justify-content: center; gap: 14px; padding: 20px 20px 0; background: rgba(40, 51, 65, .45); border-radius: 12px 12px 0 0; }
  .skyline-floor { height: 14px; background: var(--dct-surface); border-top: 1px solid var(--dct-border); }
  /* The homepage drawing styles define a global .rack (padding, border, paper fill); neutralise it. */
  .rack { display: block; flex: 1 1 0; min-width: 0; max-width: 72px; height: auto; margin: 0; padding: 0; border: 0; background: none; }
  .rack::before { content: none; }
  .r-body { fill: var(--dct-header); stroke: var(--dct-border); }
  .r-cap { fill: var(--dct-normal-border); }
  .r-unit { fill: var(--dct-surface); stroke: var(--dct-border); stroke-width: .75; }
  .led { fill: var(--dct-success); }
  .led-white { fill: var(--dct-text); }
  @keyframes dct-led { to { opacity: .3; } }
  @media (prefers-reduced-motion: no-preference) {
    .led-blink { animation: dct-led 2.4s steps(2, start) infinite; }
  }
  @media (width < 780px) {
    .rack-skyline { margin-top: 2rem; }
    .skyline-racks { gap: 8px; }
    .rack:nth-child(n+8) { display: none; }
  }
  @media (width >= 780px) and (width < 1100px) {
    .rack:nth-child(n+12) { display: none; }
  }
</style>
