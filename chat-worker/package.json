{
  "name": "portfolio-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:dry-run": "wrangler deploy --dry-run --env beta && wrangler deploy --dry-run --env production",
    "deploy": "npm run deploy:beta",
    "deploy:beta": "wrangler deploy --env beta",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
