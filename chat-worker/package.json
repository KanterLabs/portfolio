{
  "name": "portfolio-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "knowledge:audit": "tsx scripts/knowledge-cli.ts audit",
    "knowledge:review": "tsx scripts/knowledge-cli.ts review",
    "knowledge:generate": "tsx scripts/knowledge-cli.ts generate",
    "d1:migrate:local": "wrangler d1 migrations apply CHAT_HISTORY --local",
    "d1:migrate:production": "wrangler d1 migrations apply CHAT_HISTORY --remote --env production",
    "deploy:dry-run": "wrangler deploy --dry-run --env production",
    "deploy": "npm run deploy:production",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
